{
  "name": "big-data-tracking-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @app/client --filter @app/server dev",
    "dev:client": "pnpm --filter @app/client dev",
    "dev:server": "pnpm --filter @app/server dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/server build && pnpm --filter @app/client build",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "~6.0.2"
  }
}
